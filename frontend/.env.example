# Frontend-only configuration.
#
#   cp .env.example .env.local
#
# NEXT_PUBLIC_* values are inlined at build time, so restarting the server is not enough
# after a change — rebuild (`npm run build`, or `docker compose build web`).
#
# Local development against the API started on port 8123:
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8123/api/v1
#
# Production is configured in the repository-root .env (docker compose passes it as a build
# arg), not here: the deployed frontend must call the public API origin, for example
#   NEXT_PUBLIC_API_BASE=https://api.indigeo.example.org/api/v1
