# IndiGeo configuration.
#
#   cp .env.example .env     # then edit; the real .env is git-ignored
#
# Read by the API through pydantic-settings (case-insensitive), by `docker compose` for
# interpolation, and by the frontend only through NEXT_PUBLIC_* at build time.
# Values below are the local-development defaults. The production values that must change
# are marked "PRODUCTION:".

# --- runtime ---------------------------------------------------------------
# local | development | test | staging | production. Outside the first three the API logs a
# warning if CORS_ORIGINS still only lists localhost.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Allow the browser origin(s). CSV or JSON both parse. Scheme included, no trailing slash.
# PRODUCTION: the exact public frontend origin, e.g. https://indigeo.example.org
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- frontend --------------------------------------------------------------
# Inlined into the JS bundle at build time; changing it requires a rebuild, not a restart.
# PRODUCTION: the public API origin, e.g. https://api.indigeo.example.org/api/v1
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8123/api/v1

# --- container bind addresses (docker compose only) ------------------------
# Keep both on loopback and terminate TLS at a reverse proxy in front of them.
API_BIND=127.0.0.1
WEB_BIND=127.0.0.1

# --- storage ---------------------------------------------------------------
# Unset means the API's defaults under ./data (and /data inside the container). Set these
# only when state lives elsewhere; relative paths resolve against the process CWD.
# DATA_DIR=./data
# DATABASE_URL=sqlite:///./data/indigeo_relational.db
# SPATIAL_DUCKDB_PATH=./data/indigeo_spatial.duckdb

# duckdb is the only implemented spatial backend in this build.
SPATIAL_BACKEND=duckdb

# --- caches and background work -------------------------------------------
# In-process TTL+LRU over location lookups. Hazard evidence is never cached.
CACHE_ENABLED=true
GEOCODE_CACHE_TTL_SECONDS=600
GEOCODE_CACHE_MAX_ENTRIES=512
POINT_CACHE_TTL_SECONDS=300
POINT_CACHE_MAX_ENTRIES=256
# Thread slots for POST /analysis/jobs. DuckDB/SQLite are single-writer files, so this
# multiplies concurrent jobs, not raw write throughput.
ANALYSIS_WORKERS=2

# --- local OSM extracts ----------------------------------------------------
# Regional .pbf / GeoJSON / GeoPackage extracts listed in OSM_EXTRACT_DIR/manifest.json are
# queried first; Overpass is then asked only for the layers (or the bbox) they miss. A file
# that is not listed in the manifest is never read. Formats are whatever GDAL/pyogrio can
# open - a Geofabrik .pbf works without pyrosm/osmnx.
OSM_LOCAL_ENABLED=true
# OSM_EXTRACT_DIR=./data/osm_extracts
# OSM_MANIFEST_NAME=manifest.json

# --- local raster DEMs -----------------------------------------------------
# SRTM 30 m / ISRO Bhuvan GeoTIFFs listed in DEM_DIR/local/manifest.json are sampled at
# native resolution before the Terrarium tile pyramid. Without a manifest the engine falls
# back to tiles and states that reason in the response.
DEM_LOCAL_ENABLED=true
# DEM_DIR=./data/dem
# DEM_MANIFEST_NAME=manifest.json
# Caps the sampled window, not the source resolution; larger windows are downsampled.
DEM_MAX_WINDOW_PIXELS=2048

# --- live Indian hazard feeds ----------------------------------------------
# None of these publishers offers a verified key-free endpoint, so every connector stays
# unconfigured until an operator supplies the URL they are licensed to query. Empty means
# "not queried and reported as a gap", never "no alert exists".
IMD_ALERTS_URL=
CWC_GAUGES_URL=
CWC_API_KEY=
BHUVAN_HAZARDS_URL=
BHUVAN_API_KEY=
LIVE_FEED_CACHE_TTL_SECONDS=900
LIVE_FEED_TIMEOUT_SECONDS=12
# A gauge within this distance still counts as measuring the same river reach.
CWC_SEARCH_RADIUS_M=25000

# --- upstream providers ----------------------------------------------------
HTTP_TIMEOUT_SECONDS=20
PROVIDER_CACHE_TTL_SECONDS=21600
# Nominatim's usage policy requires a real contact; the default string is not one.
NOMINATIM_USER_AGENT=IndiGeo/0.1 (set a real contact here)
NOMINATIM_MIN_INTERVAL_SECONDS=1.1

# Wall-clock ceiling for one lifeline lookup across all OSM layers. Serial mirror-walking
# measured 504-624 s; layers now run concurrently under this budget and a layer that does
# not answer is reported unavailable with the elapsed time, never as zero features.
OVERPASS_DEADLINE_SECONDS=90
OVERPASS_LAYER_CONCURRENCY=4
OVERPASS_MIRRORS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass.kumi.systems/api/interpreter

# Optional sources. Empty is a supported state: the analysis reports them as gaps with a
# warning and lowers confidence instead of substituting a value.
# FIRMS retired the anonymous key; a free personal MAP_KEY is required for fire detections.
FIRMS_MAP_KEY=
EARTHDATA_TOKEN=

# --- API auth (off by default for the prototype) ---------------------------
API_REQUIRE_KEY=false
API_KEYS=
