# IndiGeo production configuration.
#
# This file is a template: app.yourdomain.com / api.yourdomain.com are PLACEHOLDERS.
# Replace them with the real DNS names before building. NEXT_PUBLIC_API_BASE is inlined
# into the JS bundle at build time, so changing it requires a rebuild, not a restart.
#
# Usage on the deployment host:
#   docker compose --env-file .env.production build
#   docker compose --env-file .env.production up -d
#   docker compose --env-file .env.production --profile proxy up -d   # with the Caddy service
#
# No secret belongs in this file. Tokens (FIRMS_MAP_KEY, EARTHDATA_TOKEN, API_KEYS) go in
# the host environment or a separate, non-committed env file.

ENVIRONMENT=production
LOG_LEVEL=INFO

# The api service reads this file (docker-compose.yml: env_file: ${ENV_FILE:-.env}).
ENV_FILE=.env.production

# Exact browser origin(s) allowed to call the API: scheme + host, no trailing slash.
CORS_ORIGINS=https://app.yourdomain.com

# Public API origin inlined into the web bundle at build time.
NEXT_PUBLIC_API_BASE=https://api.yourdomain.com/api/v1

# Hostnames for the optional Caddy reverse proxy (no scheme, no port).
APP_HOST=app.yourdomain.com
API_HOST=api.yourdomain.com

# Image tag applied to api / web builds and the proxy.
TAG=production

# Nominatim's usage policy requires a real contact; this placeholder must be replaced.
NOMINATIM_USER_AGENT=IndiGeo/0.1 (set a real contact here)

SPATIAL_BACKEND=duckdb
CACHE_ENABLED=true

# Storage paths are set by the API image to /data and mounted by compose; do not
# override DATABASE_URL or SPATIAL_DUCKDB_PATH here unless state lives elsewhere.

# Optional: supply a free personal key to score fire detections instead of reporting a gap.
# FIRMS_MAP_KEY=
